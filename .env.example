APP_PORT=3100
ADMIN_USERNAME=admin
# Initial password used only before the administrator credential is initialized in the database.
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_COOKIE_SECURE=
APP_TIME_ZONE=Asia/Shanghai
DATABASE_URL=file:/app/data/subscriptions.db

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=续费管家 <mailer@example.com>
MAIL_REPLY_TO=
SMTP_TEST_TO=

REMINDER_CRON_SECRET=replace-with-at-least-32-random-characters
REMINDER_CHECK_INTERVAL_MINUTES=60
REMINDER_RUN_ON_START=true
REMINDER_MAX_ATTEMPTS=3
