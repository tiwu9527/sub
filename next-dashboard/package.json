{
  "name": "subscription-manager-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/setup-database.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3100",
    "build": "next build --webpack",
    "prestart": "node scripts/setup-database.mjs",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "lint": "eslint . --max-warnings=0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "node scripts/setup-database.mjs",
    "worker:reminders": "node worker/reminder-worker.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "prisma": "^5.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.16",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
